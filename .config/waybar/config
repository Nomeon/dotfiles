{
  "layer": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": ["pulseaudio", "backlight", "battery", "network", "bluetooth", "custom/power"],

  "hyprland/workspaces": {
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "*": 4
    }
  },

  "clock": {
    "interval": 60,
    // Include the month and day of the week in the format, like Wednesday, 30 July, 14:30
    "format": "{:%A, %d %B %H:%M}",
    
    "tooltip": false
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.py",
    "interval": 900,
    "return-type": "json",
    "format": "{}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": " Muted",
    "format-icons": ["", "", ""],
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "backlight": {
    "on-scroll-up": "brightnessctl s +5%",
    "on-scroll-down": "brightnessctl s 5%-",
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", ""]
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂁", "󰁹"]
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈁 {ipaddr}",
    "format-disconnected": "󰖪",
    "tooltip": false,
    "on-click": "networkmanager_dmenu"
  },

  "bluetooth": {
      "format-on": "󰂯",
      "format-off": "󰂲",
      "format-disabled": "", // an empty format will hide the module
      "format-connected": "󰂱 {num_connections}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "~/.config/waybar/scripts/bluetooth_menu.sh"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": "Power menu",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
